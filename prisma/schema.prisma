generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  ARTISAN
}

model User {
  id             String          @id @default(uuid())
  name           String
  email          String          @unique
  /// Null for accounts created through Google or a passkey — those identities
  /// have no password to hash. Every row written before V10 keeps the hash it
  /// already has; widening this column takes nothing away.
  ///
  /// There is exactly ONE read site, `bcrypt.compare` in /api/auth/login, and it
  /// must branch on null BEFORE calling compare: bcryptjs throws on a null hash,
  /// and a caught throw that fell through to "valid" would be a total auth
  /// bypass.
  passwordHash   String?
  /// PASSWORD | GOOGLE | PASSKEY — how this account was created, and therefore
  /// which sign-in paths it may use. Defaulted so every pre-V10 row reads
  /// PASSWORD, which is what those rows actually are.
  authProvider   String          @default("PASSWORD")
  /// Google's `sub` claim, which is the only identifier Google guarantees is
  /// stable and never reused. Deliberately NOT the email: a Google address can
  /// change, and a recycled Workspace address must never inherit an account.
  /// Unique so one Google identity cannot be attached to two users.
  googleId       String?         @unique
  /// True only when Google asserted `email_verified`. This app sends no
  /// verification mail of its own, so a PASSWORD account stays false. It records
  /// what we were told, not what we checked, and nothing is gated on it yet.
  emailVerified  Boolean         @default(false)
  /// Google's `picture` claim, kept as the remote URL rather than copied into a
  /// data URL: it is already public, and re-hosting someone else's CDN content
  /// on our rows buys nothing.
  avatarUrl      String?
  role           Role
  accountStatus  String          @default("ACTIVE")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  artisanProfile ArtisanProfile?
  craftItems     CraftItem[]
  schemeApplications SchemeApplication[]
  notifications  Notification[]
  // Cluster-level resource sharing: an artisan may be on either side of a
  // request (needing wool this week, offering yarn the next), so two relations.
  resourceRequestsMade     ResourceRequest[] @relation("ResourceRequester")
  resourceRequestsAccepted ResourceRequest[] @relation("ResourceAccepter")
  // Demand acceptances — distinct from CraftItem sales. An ArtisanOrder is a
  // commitment against a buyer's bulk request; a CraftItem is a piece.
  artisanOrders            ArtisanOrder[]
  passkeys                 Passkey[]
  /// V11. The artisan's shop inside the ONE platform Shopify store — a custom
  /// collection, since Shopify's Admin API cannot create a store per artisan.
  shopifyShop              ShopifyShop?
  /// V12. Sales the artisan made away from the platform and logged themselves.
  /// A separate stream from escrow income and demand credits — never summed
  /// into either.
  offlineSales             OfflineSale[]
  /// V12. Frozen production-record snapshots the artisan chose to hand to a
  /// lender. Read-only once written; revoking sets a timestamp, never deletes.
  creditShares             CreditProfileShare[]
  /// V12. Learning items the artisan marked started or done. The skill stage is
  /// never stored — it is derived from the production record on every read.
  learningProgress         LearningProgress[]
  /// V12. When this artisan was last nudged about restocking, and whether they
  /// asked to be left alone for a week.
  supplyReminderState      SupplyReminderState?
  /// V12. Recognition badges this artisan earned from their own record.
  /// Written only by evaluateBadges() in src/lib/badgeRecord.ts; never by an
  /// admin and never manually.
  badges                   ArtisanBadge[]
  /// V12. Pattern concepts the artisan explored in the Design Lab before
  /// committing silk to them. Sketches, never product photographs — nothing
  /// here is ever read by a provenance or authenticity comparison.
  designConcepts           DesignConcept[]
  /// V12. Motif fingerprints this artisan SUBMITTED. Submitting is not owning:
  /// a registration belongs to the cluster, and this column only records who
  /// filed it so the cluster has someone to ask.
  motifRegistrations       MotifRegistration[]
  /// V12. This artisan's frozen share of each licence fee the cluster was paid.
  motifPayoutShares        MotifPayoutShare[]

  // Admin fields
  patchBankBalance Int @default(5000)
  patchBankIssued  Int @default(0)
}

/// One WebAuthn credential belonging to one user.
///
/// The private key never leaves the authenticator. What is stored here is the
/// public half plus the bookkeeping needed to notice a cloned one: `counter` is
/// the load-bearing field, because a genuine authenticator's signature counter
/// only ever increases, so a replayed or cloned assertion shows up as a counter
/// that did not advance.
model Passkey {
  id            String    @id @default(uuid())
  userId        String
  /// Cascade on purpose: a deleted user's credentials mean nothing, and leaving
  /// orphans would keep a `credentialId` claimed forever.
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// base64url, as the browser returned it. Unique across the whole table — one
  /// physical credential must never resolve to two accounts.
  credentialId  String    @unique
  /// base64url-encoded COSE public key.
  publicKey     String
  /// Signature counter. Some authenticators — notably synced platform passkeys —
  /// always report 0, so the verify route treats "was 0, still 0" as the one
  /// legitimate non-advance and rejects every other regression.
  counter       Int       @default(0)
  /// usb | nfc | ble | internal | hybrid, as reported at enrolment. Fed back
  /// into the next login's allowCredentials so the right prompt appears.
  transports    String[]
  /// Derived from the User-Agent at enrolment ("Chrome on Windows"), so someone
  /// holding three passkeys can tell which one they are revoking.
  deviceLabel   String?
  /// Whether the credential is backed up or synced. Worth showing: a
  /// device-bound key is lost with the device and a synced one is not.
  backedUp      Boolean   @default(false)
  createdAt     DateTime  @default(now())
  lastUsedAt    DateTime?

  @@index([userId])
}

model ArtisanProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id])
  craftType       String
  location        String
  mobileNumber    String?
  experienceYears Int
  cooperativeId   String?
  photoUrl        String?
  upiId           String?
  /// Optional payout account captured alongside the VPA. Never used to hold
  /// funds: settlement is always programmatic and direct to the artisan.
  bankAccountNumber String?
  description     String?
  tags            String[]
  healthScore     Float    @default(100)

  socialCategory  String?
  /// FEMALE | MALE | OTHER. Drives the Womaniya (3%) GeM purchase preference,
  /// which is open to women-owned enterprises only. Nullable so profiles that
  /// predate the field are not silently treated as one gender.
  gender          String?
  annualIncome    Float?
  aadhaarLast4    String?
  clusterName     String?
  giTagCertified  Boolean  @default(false)
  giTagName       String?

  /// Master switch for the creator/influencer affiliate programme. Opt-in, at
  /// the profile level rather than per item: an artisan who wants promotion
  /// wants it for their shop, not one saree at a time.
  promotionOptIn  Boolean  @default(false)

  /// How many times a buyer scanned a delivered piece and the AI confirmed it
  /// genuine. Each one awards HEALTH_REWARD_VERIFIED (see src/lib/artisanHealth.ts)
  /// onto `healthScore`, which stays bounded at HEALTH_MAX.
  verifiedGenuineCount Int @default(0)

  /// Link to the artisan's SHG (Self-Help Group) group page/handle, optional.
  /// When present it acts as the authoritative cluster key: everyone sharing
  /// the same link is grouped together, no matter where they physically live.
  /// When absent the /artisan/cluster page falls back to grouping by `location`
  /// among other SHG-less artisans.
  shgGroupLink    String?

  @@index([socialCategory])
  @@index([shgGroupLink])
}

model CraftItem {
  id                  String   @id @default(uuid())
  artisanId           String
  artisan             User     @relation(fields: [artisanId], references: [id])
  patchId             String?
  craftType           String
  descriptionOriginal String?
  descriptionEnglish  String?
  tags                String[]
  images              String[]
  rawMaterialProofUrl String?
  rawMaterialCost     Float?
  laborDays           Int?
  fairnessScore       Float?
  fairWageFloor       Float?
  marketPriceMin      Float?
  marketPriceMax      Float?
  standardMarketPrice Float?
  /** The price the artisan chose to list at. Null on rows captured before price-setting existed. */
  askingPrice         Float?
  creditScore         Float?
  status              String   @default("Pending")
  advancePaid         Float    @default(0)
  finalPayoutQueued   Float    @default(0)
  salePrice           Float?
  assignedAdminId     String?
  createdAt           DateTime @default(now())
  firstFailedScanAt   DateTime?
  failedScanCount     Int      @default(0)

  aiGeneratedListing   String?
  aiSuggestedCategory  String?
  giTagApplied         String?
  isListedOnMarketplace Boolean @default(false)

  // Physical QR patch attachment. An admin approving an item mints its patchId
  // but no longer publishes it: the artisan must print the QR, stick it on the
  // piece, re-photograph it, and have the AI match that photo to the original
  // capture. Only then does the item become SELLABLE and listable.
  qrVerified          Boolean   @default(false)
  qrVerifiedImageUrl  String?   // the artisan's photo of the product WITH the patch
  qrVerifiedAt        DateTime?
  /// DEMO GRANDFATHERING. When set, this piece may be bought, packed and
  /// published without `qrVerified`. Written ONCE, by a one-time script, onto
  /// the pieces that were already on the marketplace when the QR rule started
  /// being enforced at checkout (2026-09-13) — so the existing demo catalogue
  /// stayed buyable. NOTHING in the application writes this column, so every
  /// piece listed afterwards has to pass real QR verification.
  ///
  /// Kept separate from `qrVerified` on purpose: setting that flag instead would
  /// make a waived check indistinguishable from a passed one, on the buyer's
  /// verified badge and in the audit trail. To end the exemption, null this
  /// column (each grant has a `QR_RULE_GRANDFATHERED` AuditLog row).
  qrExemptAt          DateTime?

  // ---- V11: AI Photo Studio ---------------------------------------------------
  //
  // `images[0]` is still the listing photo every surface reads. These columns
  // exist because the enhance pass used to REPLACE the camera frame, with no copy
  // kept and no choice offered. Ordering-by-convention inside `images[]` ("[0]
  // is the pick, [1] the original…") would not be a contract: every existing
  // writer treats `images` as "the artisan's photos", complete-draft slices it
  // to four, and the listing grid renders `[1]` as a second product shot. Named
  // columns cannot be reshuffled by a writer that never heard of the convention.

  /// The camera frame, downscaled for storage and otherwise untouched. Written
  /// by /api/items/capture and /api/items/complete-draft. THIS — not the chosen
  /// look — is what every authenticity comparator reads (`provenanceReference()`
  /// in src/lib/buyerVerify.ts), so a background swap can never become the
  /// frame a buyer's delivered piece is judged against.
  originalImageUrl      String?
  /// The canvas-enhanced frame (white balance, levels, sharpen). Same writers.
  enhancedImageUrl      String?
  /// Which look is in `images[0]`: ORIGINAL | ENHANCED | PRESET_<name> |
  /// GENERATED_<n>. Written at capture and by the listing picker through
  /// PATCH /api/artisan/listings.
  selectedImageVariant  String?
  /// `{ v: 1, variants: [{ key, label, kind, thumb }], cutout? }` — ≤320 px
  /// thumbnails plus an optional downscaled transparent cutout, so the picker can
  /// re-render a preset later. Never a full-resolution copy of every look: the
  /// capture route drops this whole blob rather than store an oversized one.
  imageVariants         Json?
  /// 1-10, and only ever written when a score was actually produced.
  photoQualityScore     Int?
  /// The specific, kind reason behind the verdict.
  photoQualityNotes     String?
  /// AI | HEURISTIC | UNCHECKED. AI = Gemini scored this frame. HEURISTIC = only
  /// the on-device blur/exposure pre-check ran. UNCHECKED = neither did. A
  /// fallback can therefore never be mistaken for an AI verdict.
  photoQualitySource    String?
  /// Retakes of this photo. The quality gate stops prompting after the first.
  photoRetakeCount      Int       @default(0)
  /// ON_DEVICE | SERVER | NONE — which tier produced the cutout, so "no
  /// background removal" is recorded rather than implied.
  backgroundRemovalMode String?

  // ---- V11: Shopify -----------------------------------------------------------
  //
  // The FIRST channel that performs a real outbound write; every other channel in
  // src/lib/syndication.ts only stamps `syndicatedChannels`. All of these are
  // written by exactly one route, POST /api/artisan/shopify/publish.

  /// gid://shopify/Product/…, persisted the instant productCreate returns. It is
  /// the resume point: a retry after a failed image upload finds this and never
  /// creates a second product.
  shopifyProductId      String?
  /// The default variant productCreate made; the listing price goes on it.
  shopifyVariantId      String?
  /// Deterministic `karigari-<patchId|id>`. Also an idempotency key: before
  /// creating, the route looks this handle up and adopts a product it finds,
  /// which covers a crash between productCreate and the write above.
  shopifyHandle         String?
  /// NOT_PUBLISHED | PUBLISHING | LIVE | FAILED | WITHDRAWN. WITHDRAWN = sold on
  /// Karigari and set to draft on Shopify by `withdrawSoldPiece()`; terminal.
  shopifyStatus         String?
  /// When `shopifyStatus` last changed — lets a PUBLISHING claim that outlived
  /// its request (a killed function) be taken over instead of wedging the item.
  shopifyStatusAt       DateTime?
  shopifyPublishedAt    DateTime?
  /// The actionable sentence shown next to Retry. Never a stack trace.
  shopifySyncError      String?
  /// The `selectedImageVariant` currently on Shopify, so a re-publish after the
  /// artisan changes the look replaces the image and one without does not.
  shopifySyncedImageKey String?

  // Zero-ID multi-platform syndication. The artisan owns the listing outright;
  // there is no external seller account to reconcile against.
  isOndcLive           Boolean  @default(false)
  syndicatedChannels   String[]           // ONDC_PAYTM | ONDC_MAGICPIN | GEM | AMAZON_KARIGAR
  syndicatedAt         DateTime?

  // Non-custodial escrow. No admin or facilitator ever writes these: they are
  // set by /api/payments/create-order (hold) and /api/payments/settle-escrow
  // (programmatic release on dispatch / delivery).
  /// DEPRECATED. Left in place so rows written before the Razorpay migration
  /// keep their history; nothing reads or writes it any more.
  stripeSessionId        String?
  /// Razorpay order, created at checkout by /api/payments/create-order.
  razorpayOrderId        String?
  /// Written ONLY by /api/payments/verify-payment, and only once the HMAC
  /// signature checks out. A row carrying these has a payment Razorpay itself
  /// vouched for — never one the browser merely claimed.
  razorpayPaymentId      String?
  razorpaySignature      String?
  paidAt                 DateTime?
  /// What was ACTUALLY charged, in paise. This is the ₹1 demo charge (see
  /// DEMO_CHARGE_PAISE in src/lib/razorpay.ts) and is deliberately NOT the
  /// price shown to the buyer — `salePrice` carries that, and every escrow
  /// tranche and earnings figure is computed from it.
  paidAmountPaise        Int?
  escrowStatus           String?  // ESCROW_HELD | STAGE1_ADVANCE_PAID_40 | STAGE2_SETTLED_89
  advanceAmount          Float?   // 40% of gross, computed at checkout
  finalSettlementAmount  Float?   // final direct-to-artisan tranche (~49.36% of gross)
  artisanUpiDestination  String?  // snapshot of the artisan's own VPA at checkout

  /// How the two tranches left the platform: RAZORPAYX for a real UPI payout,
  /// SIMULATED for a recorded settlement with no bank credit behind it. Written
  /// by /api/payments/settle-escrow. Never claim a SIMULATED row was paid.
  payoutMode             String?  // RAZORPAYX | SIMULATED
  /// RazorpayX payout ids (`pout_…`), or `SIM_<itemId>-STAGEn` when simulated.
  stage1PayoutRef        String?
  stage2PayoutRef        String?
  creatorPayoutRef       String?

  // Creator/influencer attribution. Written by /api/payments/create-order
  // when the buyer arrived through a `?ref=<handle>` link, and paid out by
  // /api/payments/settle-escrow on DELIVERED. There is no Order table in this
  // schema — an order IS a CraftItem — so attribution lives on the item.
  affiliateCreatorId    String?
  affiliateHandle       String?
  /// 5% of gross, computed at checkout and paid to the creator's own UPI on
  /// delivery. Taken from the platform side; the artisan's share is untouched.
  affiliateCommission   Float?

  // Buyer-facing production tracking. Most of the ladder is derived from
  // `status`, `escrowStatus` and `qrVerified`; only the step between "accepted"
  // and "ready for QA" is invisible in those fields, so it is the one an
  // artisan sets by hand. A null column means "derive it".
  productionStage     String?   // ACCEPTED | IN_PRODUCTION | QUALITY_CHECK | DISPATCHED | DELIVERED
  stageUpdatedAt      DateTime?
  estimatedDeliveryAt DateTime?

  // ---- Storefront order fulfilment. -----------------------------------------
  //
  // A storefront sale IS this row (there is no Order table), but until these
  // existed it had no way to be packed, shipped or received: DISPATCHED and
  // DELIVERED were reachable only through /api/payments/settle-escrow, which
  // nothing called. So every paid piece stopped dead at quality check, the
  // artisan was told to "mark it dispatched from your Orders page" where it did
  // not appear, and the escrow was never released.
  //
  // Each timestamp has exactly one writer, and presence is the idempotency
  // guard for the step it records — the same convention `ArtisanOrder.packedAt`
  // / `dispatchedAt` / `settledAt` use for demand orders. All nullable and
  // additive: rows sold before this landed simply read as not yet packed.

  /// Set by POST /api/artisan/sales action:"pack". Requires `paidAt` and
  /// `qrVerified` — the piece being boxed is the piece the patch proves.
  packedAt            DateTime?
  /// Set by POST /api/artisan/sales action:"dispatch", in the same request that
  /// releases the 40% escrow advance. Requires `packedAt`.
  dispatchedAt        DateTime?
  courierName         String?
  trackingRef         String?
  /// Set by POST /api/buyer/sales/delivered when the buyer confirms receipt, in
  /// the same request that releases the final settlement. Requires
  /// `dispatchedAt`. The buyer, not the artisan, writes this: an artisan must
  /// never be able to release their own final payment.
  deliveredAt         DateTime?

  // Anti-exploitation pricing guardian (new_admin.md Tier 1.1)
  pricingFlag         Boolean  @default(false)
  flagReason          String?

  // ---- Revised capture pipeline (see CAPTURE MODEL spec) ----
  /// "A" (verified + advance eligible) or "B" (verified only, no advance).
  /// Computed at capture time from `askingPrice`, `aiPriceCeiling`, and
  /// `claimsFlag`. Null for rows captured before this pipeline landed.
  aiTier              String?
  /// Convenience mirror of `aiTier == "A"`. Read by the settlement engine so
  /// a Tier B row never triggers a dispatch advance payout.
  advanceEligible     Boolean  @default(false)
  /// Combined AI ceiling (max of Step-4 ceiling and Step-5 market_high).
  aiPriceCeiling      Float?
  /// Market average from the Step-5 lookup, in INR.
  aiMarketAvg         Float?
  /// "none" | "exorbitant_labor" | "exorbitant_material" | "both". Result of
  /// the Step-6 Groq claims validator.
  claimsFlag          String?
  /// Compact ONDC RET12 catalog blob generated in Step 3. Kept as JSON so the
  /// syndication hub can read title/desc/tags/category without re-running Groq.
  aiCatalog           Json?

  // Digital-inclusion telemetry (new_admin.md Tier 2.1)
  catalogMethod       String?  // "VOICE" | "MANUAL" | "IVR"
  voiceLanguage       String?  // "Odia" | "Hindi" | "Telugu" | "English"
  audioUrl            String?  // optional; null for legacy rows
  /// Twilio CallSid of the toll-free IVR call that created this draft.
  /// Null for every item captured inside the app.
  ivrCallSid          String?

  // Who bought it. Buyers have no account in this app — the storefront is
  // unauthenticated — so a purchase carries the same free-text identity the
  // demand board uses (`Demand.buyerName`), captured at the Razorpay modal.
  // That name is what /api/buyer/orders looks an order up by.
  buyerName           String?
  buyerContact        String?
  /// The bulk request this purchase was made against, when the buyer arrived
  /// from a demand match. Null for an ordinary storefront sale.
  relatedDemandId     String?

  auditLogs           AuditLog[]
  /// V12. Motif registrations whose reference crop came from this piece.
  motifRegistrations  MotifRegistration[]

  reviews             Review[]
  tickets             Ticket[]
  /// Demand commitments this piece was bound to at ready-check time. A list
  /// rather than a single row because the same piece could, in principle, be
  /// the one presented against more than one demand over its life.
  artisanOrders       ArtisanOrder[]
  /// V12. Set when the artisan logged this piece as sold at a haat, to a
  /// walk-in, at an exhibition or through a middleman. Its presence is why the
  /// piece reads `SOLD_OFFLINE`; nothing about it touches the escrow columns.
  offlineSale         OfflineSale?

  @@index([artisanId])
  @@index([patchId])
  @@index([status])
  @@index([createdAt])
  @@index([pricingFlag])
  @@index([affiliateCreatorId])
  @@index([buyerName])
  @@index([relatedDemandId])
  @@index([shopifyStatus])
}

model AuditLog {
  id            String    @id @default(uuid())
  craftItemId   String
  craftItem     CraftItem @relation(fields: [craftItemId], references: [id])
  actorId       String?
  actorRole     String
  action        String
  previousState Json?
  newState      Json?
  comments      String?
  createdAt     DateTime  @default(now())
}

model SchemeApplication {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  /// Stable key from src/lib/schemes.ts (SchemeKey). Replaces fuzzy name matching.
  schemeKey  String?
  schemeName String
  status     String    @default("ELIGIBLE")
  appliedAt  DateTime?
  notes      String?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([userId, schemeKey])
}


/// Buyer-posted bulk requirement. Public board: buyers have no account in this
/// app yet, so a demand carries a free-text `buyerName` instead of a userId.
model Demand {
  id              String   @id @default(uuid())
  craftType       String
  quantity        Int
  targetPriceMin  Float?
  targetPriceMax  Float?
  location        String?
  festival        String?
  buyerName       String?
  notes           String?
  status          String   @default("OPEN") // OPEN | MATCHED | FULFILLED
  createdAt       DateTime @default(now())

  // What the buyer actually wants, in their own words and with a picture.
  // The board is unauthenticated, so this is the only channel a buyer has to
  // describe a piece — and it is what the artisan reads before accepting.
  /// Buyer-supplied reference photo, stored as a data URL like every other
  /// image in this schema. There is no upload bucket.
  referenceImageUrl String?
  material          String?   // "Tussar silk", "Cotton"
  color             String?   // "Deep maroon"
  /// Free-text specifics, distinct from the internal `notes` field.
  description       String?
  /// AI confidence from the last match run, 0-1. Null when matching has not
  /// run or the model was unavailable — never a fabricated score.
  matchScore        Float?

  // ---- V9: what the buyer actually asked for, structured. -------------------
  // Everything below is written by POST /api/demand from the five-section
  // "Raise a Demand" form, and read by the matcher (src/lib/notifications.ts)
  // and by the artisan before they accept (DemandRequestCard).

  /// Top-level craft family the buyer picked from the form's fixed list
  /// ("Saree & Textile", "Pottery & Ceramics", …). Distinct from `craftType`,
  /// which stays the buyer's own words: the category is what the matcher can
  /// compare across artisans, the craftType is what the artisan reads.
  category               String?
  /// The specific article inside that category ("Dupatta", "Dinner set").
  /// Free text with a datalist, so a buyer is never blocked by a missing option.
  productType            String?
  /// Dimensions in the buyer's own words — "6.3 m x 1.1 m", "18 inch tall".
  /// Deliberately unparsed: a furniture buyer and a saree buyer do not share a
  /// unit, and guessing one wrong is worse than showing the artisan the string.
  sizeSpec               String?
  /// Whether the buyer wants something made to their spec rather than off the
  /// shelf. Defaulted rather than nullable so every row written before V9 reads
  /// "no", which is what those rows actually meant.
  customizationRequired  Boolean   @default(false)
  /// Only meaningful when `customizationRequired`. Never shown otherwise.
  customizationDetails   String?
  /// Up to four reference photos, data URLs like every other image in this
  /// schema. `referenceImageUrl` above is kept as the legacy first-image mirror
  /// so every reader written before V9 keeps working untouched.
  referenceImageUrls     String[]
  /// When the buyer needs the goods in hand. Null means "flexible" — the form
  /// offers that explicitly, so null is a choice here rather than missing data.
  requiredBy             DateTime?
  /// DELIVERY | PICKUP. Guarded against an allow-list in POST /api/demand; an
  /// unknown value falls back to the default rather than failing the post.
  deliveryMode           String    @default("DELIVERY")
  /// INDIVIDUAL | BULK | WHOLESALE. Drives the capacity signal in the matcher.
  purchaseType           String    @default("INDIVIDUAL")
  /// "Anything else the artisan should know?" — the artisan-facing free text
  /// that replaces `notes` on the form. `notes` is never written again after
  /// V9, but the column stays because live rows carry content in it and the
  /// buyer board renders it; readers use `additionalRequirements ?? notes`.
  additionalRequirements String?

  // Flexibility matrix: what the artisan may propose INSTEAD of what the buyer
  // literally asked for. Every one defaults to the stricter reading, so a row
  // written before V9 is never presented as more permissive than the buyer was.
  /// STRICT | FLEXIBLE
  flexBudget             String    @default("STRICT")
  /// STRICT | FLEXIBLE
  flexColor              String    @default("STRICT")
  /// STRICT | FLEXIBLE
  flexMaterial           String    @default("STRICT")
  /// STRICT | FLEXIBLE
  flexDelivery           String    @default("STRICT")
  /// EXACT | SIMILAR
  flexDesign             String    @default("EXACT")

  artisanOrders      ArtisanOrder[]
  buyerNotifications BuyerNotification[]

  /// Set by /api/buyer/orders/delivered when the buyer marks the goods received.
  /// Distinct from the CraftItem-level DELIVERED stage: this is the buyer's own
  /// acknowledgement against the whole demand.
  deliveredAt         DateTime?
  /// True once /api/buyer/orders/verify has run and the Gemini Vision comparison
  /// confirmed the received product matches the artisan's original capture.
  deliveryVerified    Boolean    @default(false)
  deliveryVerifiedAt  DateTime?
  /// The patchId the buyer scanned or typed at verification time.
  deliveryScanPatchId String?
  /// AI similarity score (0–100) from the verification pass.
  deliveryScanScore   Float?

  @@index([craftType])
  @@index([status])
  @@index([createdAt])
  // No index on `buyerName` or `category`: nothing filters a Demand by either.
  // The buyer's board fetches the whole board and narrows by name in React, and
  // `category` is read off a row that has already been loaded rather than
  // searched on. An index with no WHERE clause behind it is write cost and a
  // false promise to whoever reads this file next — add one when a query
  // actually needs it.
}

/// One buyer's star + text review of a `CraftItem` they bought.
///
/// Buyers have no accounts in this app — the identity is the free-text
/// `buyerName` captured at Razorpay checkout, matched case-insensitively
/// against the item's `CraftItem.buyerName`. A row here is only written after
/// `/api/reviews` has confirmed the same person paid for the piece.
model Review {
  id           String    @id @default(uuid())
  craftItemId  String
  craftItem    CraftItem @relation(fields: [craftItemId], references: [id])
  /// The buyer name at the time of purchase — the join key for "did I buy this?".
  buyerName    String
  /// Optional; captured for the artisan's records, never shown publicly.
  buyerContact String?
  /// 1 to 5. Enforced at the API layer.
  rating       Int
  comment      String?
  /// Optional attached photos, same data-URL convention as everywhere else.
  images       String[]
  createdAt    DateTime  @default(now())

  @@index([craftItemId])
  @@index([createdAt])
  @@index([craftItemId, buyerName])
}

/// A material or tool one cluster artisan needs, that another may lend.
///
/// `clusterName` here is the RESOLVED cluster key: an SHG link when the
/// requester belongs to one, otherwise `auto:<location>` — the same string the
/// cluster page uses to gather members. This keeps the request scoped: never
/// broadcast to the whole platform.
model ResourceRequest {
  id            String    @id @default(uuid())
  requesterId   String
  requester     User      @relation("ResourceRequester", fields: [requesterId], references: [id])
  resourceName  String
  description   String?
  quantity      String?
  /// OPEN | ACCEPTED | FULFILLED | CANCELLED. Enforced at the API layer.
  status        String    @default("OPEN")
  acceptedById  String?
  acceptedBy    User?     @relation("ResourceAccepter", fields: [acceptedById], references: [id])
  acceptedAt    DateTime?
  clusterName   String
  createdAt     DateTime  @default(now())

  @@index([clusterName, status])
  @@index([requesterId])
  @@index([createdAt])
}

/// One artisan's commitment against one buyer `Demand`.
///
/// Deliberately distinct from `CraftItem`: an ArtisanOrder is the acceptance
/// (bulk quantity, agreed price, deadline), while the CraftItems produced
/// against it stay the sold pieces. A demand can be accepted by more than one
/// artisan, so this is many-to-many via two rows rather than a shared status.
model ArtisanOrder {
  id              String     @id @default(uuid())
  artisanId       String
  artisan         User       @relation(fields: [artisanId], references: [id])
  demandId        String
  demand          Demand     @relation(fields: [demandId], references: [id])
  /// ACCEPTED | IN_PROGRESS | READY | PACKED | DISPATCHED | DELIVERED |
  /// COMPLETED | CANCELLED. Monotonic: every writer goes through
  /// `advanceOrderStatus()` in src/lib/orderStage.ts, so an order can never be
  /// walked backwards. Each value has exactly one writer, listed in
  /// docs/DEMAND_SYNC_V9_PLAN.md §2. CANCELLED is in the vocabulary because
  /// POST /api/artisan/orders already refuses to accept against a cancelled
  /// demand, but nothing in this app writes it.
  status          String     @default("ACCEPTED")
  /// Only set when the artisan negotiated; null means they took the listed price.
  negotiatedPrice Float?
  /// Defaults to 14 days out at accept time; null when no deadline was set.
  deadline        DateTime?
  /// Data URL of the finished-product photo the artisan attaches when marking
  /// the order COMPLETED. Same convention as every other image in this schema.
  completedImageUrl String?
  /// On-screen demand price credited to the artisan when the buyer marks the
  /// order delivered. Always denominated in the negotiated / agreed price —
  /// NEVER the ₹1 demo charge Razorpay actually collected. Null until the
  /// buyer confirms delivery.
  settledAmount   Float?
  /// When the credit landed. Presence is the idempotency guard: a second
  /// "mark delivered" click on the same demand cannot credit twice.
  settledAt       DateTime?

  // ---- V9: the piece, and the ready → packed → dispatched ladder. -----------

  /// The specific piece this order was fulfilled with, bound at ready-check
  /// time by /api/artisan/orders/verify-ready. Before V9 there was no link at
  /// all, so `verifyBuyerImage` could only ask "does this patch's artisan hold
  /// an order on this demand" — never "is this the piece that was promised".
  craftItemId     String?
  craftItem       CraftItem? @relation(fields: [craftItemId], references: [id])

  /// True once the artisan scanned the piece's own patch and the shared
  /// comparator matched their finished photo against its original capture.
  /// Written ONLY on a pass, in one transaction; a failed check writes nothing,
  /// so the fields below never describe an attempt that did not succeed.
  readyVerified        Boolean   @default(false)
  /// The artisan's photo of the finished piece that passed the comparison.
  readyImageUrl        String?
  /// The patch id that resolved to `craftItemId`, kept so a later dispute can
  /// see which sticker the artisan actually scanned.
  readyScanPatchId     String?
  /// 0–100 from the shared comparator. Null when no check has passed — never a
  /// placeholder number.
  readySimilarityScore Float?
  readyVerifiedAt      DateTime?

  /// Set by PATCH action:"pack". Requires `readyVerified`, so an artisan cannot
  /// tell a buyer a piece is boxed before it has been proved to be the piece.
  packedAt        DateTime?
  /// Set by PATCH action:"dispatch". Requires `packedAt`.
  dispatchedAt    DateTime?
  courierName     String?
  trackingRef     String?

  /// When the artisan last posted an OrderLog. Mirrored onto the order rather
  /// than derived, so the "no update in N days" query is a column comparison
  /// instead of a subquery per order.
  lastLogAt       DateTime?

  // ---- V10: the buyer's 40% advance, paid on acceptance. -------------------

  /// ADVANCE_PENDING | ADVANCE_INITIATED | ADVANCE_PAID | ADVANCE_WAIVED.
  /// Written by POST /api/artisan/orders on acceptance and by the two routes
  /// under /api/payments/demand-advance. Monotonic, like every other status
  /// here. ADVANCE_WAIVED is set once, at accept time, when no price could be
  /// resolved to take 40% of — nothing transitions into it afterwards.
  advanceStatus            String    @default("ADVANCE_PENDING")
  /// The REAL 40% of the agreed price, from `advanceFor()` in src/lib/escrow.ts.
  /// This is the figure the buyer is shown and the artisan is told is coming.
  /// Null when no price resolved, which is also when advanceStatus is
  /// ADVANCE_WAIVED: a zero-rupee advance is not a fact, it is a missing one.
  advanceDueAmount         Float?
  /// What Razorpay ACTUALLY took, in paise — DEMO_ADVANCE_PAISE. Kept apart from
  /// `advanceDueAmount` for the same reason `CraftItem.paidAmountPaise` is kept
  /// apart from `salePrice`: one is the demo charge and the other is the real
  /// figure, and conflating them would be the most misleading thing this app
  /// could do.
  advanceChargedPaise      Int?
  advanceRazorpayOrderId   String?
  /// Written ONLY after the HMAC signature checks out, in demand-advance/verify.
  advanceRazorpayPaymentId String?
  advanceRazorpaySignature String?
  /// Presence is the idempotency guard: the verify route's updateMany predicate
  /// is `advancePaidAt: null`, so a double submit cannot record two advances.
  advancePaidAt            DateTime?
  /// The remaining 60%, credited on delivery. Computed as
  /// `agreed - advanceDueAmount` rather than `agreed * 0.6`, which is correct by construction: the balance is whatever is left after the
    /// advance, so it cannot drift however `advanceFor()` rounds, and it stays
    /// right if ADVANCE_RATE ever becomes a figure like 1/3 that does not
    /// divide cleanly. (`agreed * 0.6` happens to agree today — for an integer
    /// price, 0.4x can never land exactly on a .5 boundary, so the two
    /// roundings always complement — but that is a coincidence of the current
    /// rate rather than a property worth relying on.)
  balanceDueAmount         Float?

  logs               OrderLog[]
  buyerNotifications BuyerNotification[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([artisanId])
  @@index([demandId])
  @@index([status])
  @@index([artisanId, demandId])
  // `craftItemId` is a foreign key, and Postgres does not index those on its
  // own — without this, every delete or update on the referenced CraftItem
  // scans this table to check the constraint.
  @@index([craftItemId])
  // Deliberately no `[artisanId, status]` or `[lastLogAt]`: the orders page
  // loads one artisan's rows on `artisanId` alone and does the status filtering
  // and the staleness arithmetic in JavaScript, so neither would ever be
  // consulted by the planner.
}

/// A dated update the artisan posts against one ArtisanOrder. Text, photo, or
/// both. The buyer's tracking view uses this later.
model OrderLog {
  id              String       @id @default(uuid())
  artisanOrderId  String
  artisanOrder    ArtisanOrder @relation(fields: [artisanOrderId], references: [id])
  note            String?
  /// Data-URL, same convention as the rest of the app.
  imageUrl        String?
  createdAt       DateTime     @default(now())

  @@index([artisanOrderId])
  @@index([createdAt])
}

/// In-app alert for one artisan. Written by the insights engine when a matching
/// demand lands or a relevant festival is near; read by the header bell and
/// replayed by the WhatsApp/SMS simulation.
model Notification {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  type            String   // DEMAND_ALERT | FESTIVAL | SCHEME | SYSTEM
  title           String
  message         String
  read            Boolean  @default(false)
  relatedDemandId String?
  channel         String?  // WHATSAPP | SMS | IN_APP
  /// Twilio Message SID when this alert actually went out as an SMS.
  outboundSid     String?
  /// Set when the artisan replied "1" to the SMS, without opening the app.
  accepted        Boolean  @default(false)
  acceptedAt      DateTime?
  createdAt       DateTime @default(now())

  @@index([userId, read])
  @@index([createdAt])
}


/// One alert for one buyer — acceptance, daily update, ready, packed,
/// dispatched, delivered, purchase.
///
/// Deliberately NOT a nullable-user `Notification`. `Notification.userId` is a
/// required FK onto `User`, and buyers have no `User` row: `Role` is
/// ADMIN | ARTISAN and nothing in this app creates a buyer account. Making that
/// column nullable would mean every existing artisan query (`where: { userId }`,
/// the unread count, the mark-all-read `updateMany`) starts scanning rows that
/// can never belong to an artisan, and a single missing `userId: { not: null }`
/// guard would leak a buyer's alerts into an artisan's bell. Worse, it would put
/// a free-text name in a column whose name and type promise a user id — exactly
/// the kind of join a later reader makes by accident.
///
/// A separate model keeps the two identity models apart at the type level: this
/// table has no `userId` to misuse, and `Notification` has no `buyerName`.
model BuyerNotification {
  id             String        @id @default(uuid())
  /// Free-text buyer identity, the same convention `Demand.buyerName`,
  /// `CraftItem.buyerName`, `Review.buyerName` and `Ticket.buyerName` use.
  /// Matched case-insensitively, because the buyer types it by hand each visit.
  buyerName      String
  demandId       String
  demand         Demand        @relation(fields: [demandId], references: [id])
  /// Null for events that belong to the demand rather than to one artisan's
  /// commitment — DEMAND_MATCHED, and PURCHASE_CONFIRMED on a demand with no
  /// accepted order behind it.
  artisanOrderId String?
  artisanOrder   ArtisanOrder? @relation(fields: [artisanOrderId], references: [id])
  /// DEMAND_MATCHED | ORDER_ACCEPTED | DAILY_UPDATE | ORDER_READY |
  /// ORDER_PACKED | ORDER_DISPATCHED | ORDER_DELIVERED | PURCHASE_CONFIRMED
  type           String
  title          String
  message        String
  read           Boolean       @default(false)
  createdAt      DateTime      @default(now())

  @@index([buyerName, read])
  @@index([createdAt])
  @@index([demandId])
  @@index([artisanOrderId])
}

/// A buyer's dispute against a piece they received.
///
/// Raised ONLY from the buyer's own scan-and-verify flow, when the Gemini
/// comparison says the delivered product does not match the artisan's original
/// capture. Buyers have no account, so the identity is the same free-text
/// `buyerName` convention `Demand.buyerName` / `CraftItem.buyerName` use.
///
/// Both photographs are snapshotted onto the row at creation time: the buyer's
/// upload and the artisan's original capture. An admin later compares them
/// side by side and records a verdict — GUILTY costs the artisan
/// HEALTH_PENALTY_GUILTY health points, NOT_GUILTY costs them nothing.
model Ticket {
  id                 String    @id @default(uuid())
  /// The verification attempt that spawned this report.
  craftItemId        String
  craftItem          CraftItem @relation(fields: [craftItemId], references: [id])
  demandId           String?
  patchId            String
  /// Free-text buyer identity, same convention as Demand.buyerName.
  buyerName          String
  buyerContact       String?
  /// The photo the buyer uploaded at verification time (data URL).
  buyerImageUrl      String
  /// Snapshot of the artisan's original capture at ticket-creation time.
  artisanImageUrl    String?
  /// The AI similarity score from the failed verification (0-100).
  similarityScore    Float?
  aiReasoning        String?
  /// OPEN | RESOLVED_GUILTY | RESOLVED_NOT_GUILTY | DISCARDED
  status             String    @default("OPEN")
  /// Populated only when an admin resolves NOT_GUILTY and writes a note.
  adminNote          String?
  resolvedByAdminId  String?
  resolvedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([status])
  @@index([buyerName])
  @@index([craftItemId])
  @@index([createdAt])
}

/// A local creator or influencer promoting verified craft.
///
/// Non-custodial, exactly like the artisan payout: `upiId` is the creator's own
/// VPA and the 5% commission is settled straight to it on delivery. Karigari
/// never holds a creator's money and no admin approves a payout.
model Creator {
  id            String   @id @default(uuid())
  name          String
  handle        String   @unique          // "shreya_styles"
  platform      String   @default("INSTAGRAM") // INSTAGRAM | YOUTUBE | NIFT_STUDENT
  profileUrl    String?
  photoUrl      String?
  nicheCategory String                     // "Handloom Sarees" | "Tribal Jewelry" | ...
  location      String?
  upiId         String                     // direct VPA for the 5% payout
  bio           String?
  totalClicks   Int      @default(0)
  totalSales    Int      @default(0)
  earningsTotal Float    @default(0)
  status        String   @default("ACTIVE")
  createdAt     DateTime @default(now())
  clicks        AffiliateClick[]

  @@index([handle])
  @@index([nicheCategory])
}

/// One visit that arrived through a creator's `?ref=` link.
///
/// `ipHash` is a salted digest, never the address itself: the only question
/// this table has to answer is "was this the same visitor twice", and storing
/// a raw IP to answer it would be collecting more than the feature needs.
model AffiliateClick {
  id          String   @id @default(uuid())
  creatorId   String
  creator     Creator  @relation(fields: [creatorId], references: [id])
  craftItemId String?
  ipHash      String?
  createdAt   DateTime @default(now())

  @@index([creatorId])
  @@index([createdAt])
}

/// An artisan's shop: a custom collection inside the ONE platform Shopify store.
///
/// Shopify's Admin API is scoped to a single store and has no way to create one
/// per artisan, so the shareable `shopUrl` below IS their shop. Written only by
/// `ensureArtisanShop()` in src/lib/shopify.ts.
model ShopifyShop {
  id               String    @id @default(uuid())
  /// @unique is the concurrency guard. The row is CLAIMED before any collection
  /// is created in Shopify, so two simultaneous first publishes cannot both
  /// create one — the second hits the constraint and waits for the first.
  artisanId        String    @unique
  artisan          User      @relation(fields: [artisanId], references: [id])
  /// Null while `status` is CREATING.
  collectionId     String?
  /// The handle Shopify actually assigned; it suffixes on collision.
  collectionHandle String?
  shopUrl          String?
  /// CREATING | ACTIVE | FAILED
  status           String    @default("CREATING")
  productCount     Int       @default(0)
  createdAt        DateTime  @default(now())
  lastSyncedAt     DateTime?
}

/// One sale the artisan made away from the platform — a haat stall, a walk-in
/// customer, an exhibition, or a middleman pickup.
///
/// Deliberately NOT a `CraftItem`. A CraftItem is a piece Karigari catalogued,
/// photographed, QR-verified and can vouch for; an OfflineSale is the artisan's
/// own bookkeeping, unverified by anyone, and it must never be presented as
/// platform-settled income. When it names a catalogued piece, `craftItemId`
/// links them and that piece leaves the marketplace (status SOLD_OFFLINE) —
/// one physical object cannot be sold twice.
///
/// Written by POST /api/artisan/offline-sales and by the offline queue replay,
/// which posts to that same route. Nothing else writes this table; the only
/// delete is that route's DELETE, inside 24 hours of `createdAt`.
model OfflineSale {
  id             String     @id @default(uuid())
  artisanId      String
  artisan        User       @relation(fields: [artisanId], references: [id])
  /// The catalogued piece, when the artisan picked one. Null for a sale of
  /// something that was never listed — which is the common case at a haat.
  /// @unique is the concurrency guard: one piece, at most one offline sale row,
  /// so two devices logging the same piece cannot both succeed.
  craftItemId    String?    @unique
  craftItem      CraftItem? @relation(fields: [craftItemId], references: [id])
  /// What was sold, in the artisan's own words. Always set, even when
  /// `craftItemId` is too, so a later delete of the piece cannot orphan the
  /// ledger line.
  craftTypeLabel String
  /// Rupees actually received, for the whole line. Whole rupees: this is cash
  /// in a hand, and a paisa figure here would never reconcile.
  amount         Int
  quantity       Int        @default(1)
  /// HAAT | WALK_IN | EXHIBITION | MIDDLEMAN | OTHER. Guarded against an
  /// allow-list in the route; an unknown value falls back to OTHER rather than
  /// failing the log — an artisan must never lose a sale to a validation error.
  channel        String     @default("HAAT")
  buyerName      String?
  /// When the sale happened, which is not when it was logged: signal at a haat
  /// is poor and most rows arrive that evening. Never in the future.
  soldAt         DateTime
  notes          String?
  /// MANUAL | VOICE — digital-inclusion telemetry, same convention as
  /// `CraftItem.catalogMethod`.
  captureMethod  String     @default("MANUAL")
  /// The language the artisan spoke, when `captureMethod` is VOICE.
  voiceLanguage  String?
  createdAt      DateTime   @default(now())

  @@index([artisanId, soldAt])
  @@index([craftTypeLabel])
}

/// One marketplace search, recorded so demand signals are measured rather than
/// assumed.
///
/// There is no buyer account, so there is no searcher identity here and none is
/// wanted: the only question this table answers is "what are people looking for
/// this month". `ipHash` is a salted digest — the same reasoning, and the same
/// `saltedIpHash()` in src/lib/searchLog.ts, as `AffiliateClick.ipHash` — used
/// solely to keep one person refreshing a page from registering as a trend.
///
/// Written only by POST /api/market/search-log. Read only by
/// GET /api/artisan/buyers, for "What buyers are looking for".
model MarketplaceSearch {
  id          String   @id @default(uuid())
  /// Lower-cased, trimmed, collapsed whitespace, at most 80 characters. Raw
  /// input is never stored.
  term        String
  /// How many listed items the search returned. A term with zero results is the
  /// most valuable row in this table: it is unmet demand.
  resultCount Int
  ipHash      String?
  createdAt   DateTime @default(now())

  @@index([term])
  @@index([createdAt])
}

/// A shareable, read-only snapshot of one artisan's production record.
///
/// The snapshot is FROZEN at creation: a loan officer who opens the link a week
/// later must see the figures the artisan showed them, not a silently changed
/// set. `token` is the capability — the public page has no session and no other
/// identifier, so the token is two `crypto.randomUUID()` values concatenated
/// (hyphens removed, 64 hex characters) and is never derived from the artisan's
/// id.
///
/// Karigari is not a credit bureau and this is not a credit rating: the record
/// counts what happened on the platform, and every page that renders it says
/// so.
///
/// Written by POST /api/artisan/credit-profile. Revoked by DELETE on the same
/// route. `viewCount` / `lastViewedAt` are written only by the public read in
/// src/lib/creditRecord.ts. Nothing else writes this table.
model CreditProfileShare {
  id           String    @id @default(uuid())
  artisanId    String
  artisan      User      @relation(fields: [artisanId], references: [id])
  token        String    @unique
  /// The whole computed profile at share time, including the score, every
  /// component, the counts behind them and the algorithm version. Counts only:
  /// no buyer names, contact details or bank fields are ever put in here.
  snapshot     Json
  /// `CREDIT_ALGO_VERSION` at share time. Bumped whenever the scoring formula
  /// changes, so an old snapshot can be rendered with the caveat that the method
  /// has moved on.
  version      Int       @default(1)
  /// Who it was made for, in the artisan's words ("SBI Rourkela branch").
  sharedWith   String?
  viewCount    Int       @default(0)
  lastViewedAt DateTime?
  /// Set at creation, 1 to 90 days out. An expired link reads as gone.
  expiresAt    DateTime
  /// Presence is the revocation. The row is kept so the artisan's history of
  /// who they shared with stays intact.
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  @@index([artisanId])
}

/// One learning item the artisan opened or marked done.
///
/// Progress is stored, skill stage is NOT: the stage is derived from the
/// artisan's production record on every read (see src/lib/skillStage.ts), so it
/// can never drift out of step with the sales and listings it claims to
/// summarise. Storing it would create a second source of truth for a number
/// already knowable. The recommendation set itself is not stored either: it is
/// cached on the phone (src/lib/learningCache.ts) and briefly in server memory.
///
/// "Done" is the artisan's own word — nobody checks that the video was watched —
/// and every screen that counts these rows calls them lessons the artisan marked
/// done, never lessons passed.
///
/// Written only by POST /api/artisan/learning-progress. Nothing else writes this
/// table.
model LearningProgress {
  id         String   @id @default(uuid())
  artisanId  String
  artisan    User     @relation(fields: [artisanId], references: [id])
  /// Stable key: `track:slug` — e.g. `business:pricing-basics`, or
  /// `design:ai-<hash>` for an AI suggestion. Never a title, which is
  /// translated and would not match across languages.
  moduleKey  String
  /// STARTED | COMPLETED. Presence of COMPLETED is what the progress bar counts.
  /// Opening the YouTube search writes STARTED (never over COMPLETED); undoing
  /// "mark as done" moves COMPLETED back to STARTED.
  status     String   @default("STARTED")
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())

  @@unique([artisanId, moduleKey])
  @@index([artisanId])
}

/// When an artisan was last nudged about restocking, and when they last asked
/// to be left alone.
///
/// A row per artisan, created on first evaluation. Kept out of ArtisanProfile
/// because it is scheduler bookkeeping rather than anything about the artisan,
/// and because a "remind me later" must not touch a profile row that scheme
/// eligibility reads.
///
/// There is no cron in this app. The check runs lazily on a request the artisan
/// is already making (the dashboard), and `lastRemindedAt` is what makes it
/// idempotent: the reminder is claimed with a conditional updateMany on this
/// row before the Notification is written, so ten dashboard loads in a minute
/// produce one alert.
///
/// Written only by src/lib/supplyReminder.ts.
model SupplyReminderState {
  id             String    @id @default(uuid())
  artisanId      String    @unique
  artisan        User      @relation(fields: [artisanId], references: [id])
  lastRemindedAt DateTime?
  /// Set by "remind me later"; no reminder is written while this is in the
  /// future. Presence, not a boolean, so the snooze expires by itself.
  snoozedUntil   DateTime?
  remindCount    Int       @default(0)
  updatedAt      DateTime  @updatedAt
}

/// One earned recognition badge.
///
/// Awarded by `awardBadges()` in src/lib/badgeRecord.ts from the artisan's own
/// real record — never by an admin, never manually, never for logging in. That
/// function is the single writer of every column here.
///
/// The @@unique is the whole idempotency story: the evaluator runs on every
/// dashboard load and at every moment a badge could newly be earned, and simply
/// cannot double-award. A badge is never deleted either: it records that
/// something was true, so a later price experiment or a late delivery does not
/// take back what the artisan already did.
model ArtisanBadge {
  id         String   @id @default(uuid())
  artisanId  String
  artisan    User     @relation(fields: [artisanId], references: [id])
  /// Stable key from src/lib/badges.ts (FIRST_SALE, TEN_SALES, …). Titles are
  /// i18n keys resolved at render, never stored.
  key        String
  /// The real figures that earned it, frozen at award time — so a badge can
  /// always explain itself even after the underlying rows change.
  basis      Json
  awardedAt  DateTime @default(now())

  @@unique([artisanId, key])
  @@index([artisanId])
}

/// One design concept an artisan explored before committing material.
///
/// `spec` is the pattern grammar (src/lib/motifSpec.ts) and is the source of
/// truth: the SVG is a pure function of it, so a saved concept re-renders
/// identically without storing a large string. `svgThumb` is cached only so the
/// concept rail can show a thumbnail without re-running the renderer.
///
/// Explicitly NOT a product photograph. No row here is ever written into
/// `CraftItem.images`, `originalImageUrl` or anything `verifyLook()` and the
/// buyer's authenticity comparison read — a drawing must never be able to stand
/// in for a photograph of the real piece.
///
/// Written only by /api/artisan/design-lab.
model DesignConcept {
  id             String   @id @default(uuid())
  artisanId      String
  artisan        User     @relation(fields: [artisanId], references: [id])
  /// What the artisan asked for, in their own words.
  prompt         String
  /// The language they said it in, so a saved concept can be reread in it.
  promptLanguage String?
  title          String
  /// MotifSpec — grid, motif, repeat, palette, stroke, border. Every field is
  /// clamped by `validateSpec()` before it is written, so a stored spec can
  /// never render something the composer would refuse to draw.
  spec           Json
  /// AI | FALLBACK — whether a model produced the spec or the rule-based
  /// composer did, so the UI never over-claims which one the artisan is seeing.
  source         String   @default("AI")
  /// The rendered thumbnail, produced server-side by our own renderer and
  /// capped at 40 KB. Null when it could not be produced.
  svgThumb       String?
  /// Set when the artisan started a listing from this concept, so "did the lab
  /// lead to real work" has an answer. The listing takes WORDS from the concept
  /// and never the drawing.
  usedForItemId  String?
  createdAt      DateTime @default(now())

  @@index([artisanId, createdAt])
}

/// A registered motif fingerprint, owned by the CLUSTER rather than by one
/// artisan.
///
/// A tradition belongs to the village that carries it, and attributing it to
/// whoever happened to photograph it first would be the exact appropriation
/// this feature exists to resist. `submittedById` therefore records who filed
/// the record, never who owns it; every payout splits across the cluster.
///
/// What this row IS: a timestamped registration on Karigari. What it is NOT: a
/// Geographical Indication, a legal intellectual-property right, or anything a
/// registry outside this app has granted. No surface may say otherwise — see
/// src/components/MotifDisclaimer.tsx, which is rendered on every motif screen.
///
/// `hash` is a 64-bit perceptual hash (src/lib/motifHash.ts) as 16 hex chars.
/// Perceptual, not cryptographic, on purpose: two photographs of the same saree
/// MUST collide, which is the whole point, and SHA-256 never would.
///
/// Written by POST /api/motif/register. `status` is moved only by an admin.
model MotifRegistration {
  id            String     @id @default(uuid())
  /// Resolved cluster key — shgGroupLink or `auto:<location>`, per the app-wide rule.
  clusterKey    String
  /// The artisan who submitted it, for credit and contact. NOT the owner.
  submittedById String
  submittedBy   User       @relation(fields: [submittedById], references: [id])
  craftItemId   String?
  craftItem     CraftItem? @relation(fields: [craftItemId], references: [id])
  /// Human name the cluster gave the motif.
  name          String
  /// 16 hex chars. Deliberately NOT unique: a legitimate re-registration of a
  /// variant is normal, and a unique constraint would be enforced on a value
  /// that is meant to collide. Duplicates are surfaced for human review instead.
  hash          String
  /// `{ motifs, symmetry, repeatUnit, palette, confidence, source }` — the
  /// structured description. `source` is AI or HEURISTIC and is always shown,
  /// so a colour histogram is never presented as a model's reading.
  descriptors   Json
  /// Downscaled crop the hash was computed from, for human review. The hash is
  /// computed in the BROWSER from this image; the server validates its format
  /// and trusts the value, which is acceptable because a fingerprint here is a
  /// discovery aid a human reviews, never an authorisation.
  referenceImageUrl String?
  /// PENDING | REGISTERED | FLAGGED_DUPLICATE | REJECTED
  status        String     @default("PENDING")
  /// Set when review found an existing near-identical registration elsewhere.
  duplicateOfId String?
  /// Hamming distance to `duplicateOfId`, so a reviewer sees how close it is
  /// rather than being told "duplicate" and having to trust it.
  duplicateDistance Int?
  adminNote     String?
  reviewedById  String?
  reviewedAt    DateTime?
  /// Whether the cluster is open to licensing enquiries for this motif.
  licensable    Boolean    @default(true)
  registeredAt  DateTime   @default(now())

  licences      MotifLicence[]

  @@index([clusterKey])
  @@index([hash])
  @@index([status])
}

/// A brand's request to use a registered motif, and the fee recorded against it.
///
/// Nothing is auto-approved: a human acting for the cluster accepts or declines,
/// and a fee exists only once somebody agreed one.
///
/// Money follows the platform's existing honesty convention — `payoutMode` is
/// RAZORPAYX only when a real payout ran and SIMULATED otherwise, and a
/// SIMULATED row is never described as paid.
model MotifLicence {
  id              String            @id @default(uuid())
  motifId         String
  motif           MotifRegistration @relation(fields: [motifId], references: [id])
  /// Free-text enquirer identity — the public page has no accounts, the same
  /// convention as `Demand.buyerName`.
  licenseeName    String
  licenseeContact String
  /// What they want to use it for, in their words.
  intendedUse     String
  /// Units or volume they described. Unparsed free text, deliberately: a number
  /// this app invented from prose would read as a term somebody agreed.
  scope           String?
  /// Fee the cluster asked for, in whole rupees. Null until a figure is agreed.
  feeAmount       Int?
  /// REQUESTED | ACCEPTED | DECLINED | PAID | WITHDRAWN
  status          String            @default("REQUESTED")
  /// RAZORPAYX | SIMULATED — never null once status is PAID.
  payoutMode      String?
  payoutRef       String?
  /// What the cluster said when they accepted or declined, in their own
  /// words. Stored so a brand can be told WHY, rather than only that the
  /// answer was no.
  decisionNote    String?
  decidedById     String?
  decidedAt       DateTime?
  /// Salted digest of the enquirer's address — the same one-way hash
  /// `MarketplaceSearch` and `AffiliateClick` already store. It answers one
  /// question, "was this the same visitor in the last hour", which is what the
  /// rate limit needs; a raw address would collect far more than that.
  ipHash          String?
  /// Presence is the idempotency guard: a second "pay out" cannot split twice.
  paidAt          DateTime?
  createdAt       DateTime          @default(now())

  distributions   MotifPayoutShare[]

  @@index([motifId])
  @@index([status])
}

/// How one licence fee was split across the cluster's artisans.
///
/// Equal shares among artisans holding a registered, non-duplicate motif in that
/// cluster, computed at payout time and FROZEN: a later joiner must not
/// retroactively dilute a distribution that was already settled. The remainder
/// is distributed rupee by rupee to the earliest registrants, so the shares sum
/// to exactly the fee and no money rounds away.
model MotifPayoutShare {
  id         String       @id @default(uuid())
  licenceId  String
  licence    MotifLicence @relation(fields: [licenceId], references: [id])
  artisanId  String
  artisan    User         @relation(fields: [artisanId], references: [id])
  amount     Int
  payoutMode String
  payoutRef  String?
  createdAt  DateTime     @default(now())

  @@unique([licenceId, artisanId])
  @@index([artisanId])
}
