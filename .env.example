# ---------------------------------------------------------------------------
# KARIGARI — environment template
#
# Copy to `.env` and fill in. `.env` is gitignored; never commit real values.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# Supabase -> your project -> Connect -> Session pooler. Port 5432, host
# contains "pooler". Used by the app at runtime through the Prisma driver
# adapter (src/lib/prisma.ts).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# Direct (non-pooled) connection, used ONLY by the Prisma CLI for
# `db push` / migrations. Supabase -> Connect -> Direct connection.
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# --- Auth ------------------------------------------------------------------
# Signs the `auth-token` cookie. Any long random string; generate with
# `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
JWT_SECRET=

# --- AI --------------------------------------------------------------------
# Free key from https://aistudio.google.com/apikey. Powers the voice assistant,
# vision verification, listing descriptions and market insights.
# Every AI surface degrades to a rules-based answer when this is missing or
# rate-limited, so the app still runs without it.
GEMINI_API_KEY=

# --- Twilio ----------------------------------------------------------------
# Shared by the toll-free IVR (inbound voice) and the SMS demand alerts.
# Inbound webhooks need only the auth token and the number; the auth token is
# what validates X-Twilio-Signature.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# The public HTTPS origin Twilio calls YOUR app on — an ngrok tunnel in dev,
# the deployed origin in production. No trailing slash. Twilio signs the exact
# URL it requested, so a mismatch here fails every signature check.
#   npx ngrok http 3000
# Then set the webhooks in the Twilio Console:
#   Voice     "A call comes in"    -> POST <PUBLIC_BASE_URL>/api/ivr/voice
#   Messaging "A message comes in" -> POST <PUBLIC_BASE_URL>/api/sms/inbound
PUBLIC_BASE_URL=

# Local testing only. Each disables the X-Twilio-Signature check on its
# webhooks, and is honoured ONLY when NODE_ENV !== 'production'. Leave false:
# with the check off, anyone who learns the URL can forge calls and replies.
IVR_SKIP_SIGNATURE=false
SMS_SKIP_SIGNATURE=false

# Optional safety valve for outbound SMS. Comma-separated numbers; when set,
# demand alerts go ONLY to these. The seeded artisan profiles carry
# real-looking Indian mobile numbers, so set this to your own verified number
# while demoing. Empty = text every matched artisan.
#
# Note: a Twilio TRIAL account cannot send custom message bodies at all (only
# predefined templates), so demand alerts require an upgraded account. No code
# change is needed when you upgrade.
SMS_ALLOWLIST=
