# ---------------------------------------------------------------------------
# KARIGARI — environment template
#
# Copy to `.env` and fill in. `.env` is gitignored; never commit real values.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# Supabase -> your project -> Connect -> TRANSACTION pooler. Port 6543, host
# contains "pooler". Used by the app at runtime through the Prisma driver
# adapter (src/lib/prisma.ts).
#
# Use transaction mode (6543), NOT session mode (5432). Session mode holds a
# dedicated Postgres connection per client and caps out at pool_size 15, which
# a single artisan-dashboard load can exhaust on its own — that route fires ~13
# queries in one Promise.all. The failure looks like the app losing all its
# data: public pages keep working (one query each) while every authenticated
# screen 500s with
#   Database error XX000 (EMAXCONNSESSION) max clients reached in session mode
# Transaction mode multiplexes instead, so concurrent serverless invocations
# share connections.
#
# Keep the two query params. `pgbouncer=true` disables prepared statements,
# which transaction mode cannot support; `connection_limit=1` keeps each
# serverless instance to one connection.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1

# Direct (non-pooled) connection, used ONLY by the Prisma CLI for
# `db push` / migrations. Supabase -> Connect -> Direct connection.
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# --- Auth ------------------------------------------------------------------
# Signs the `auth-token` cookie. Any long random string; generate with
# `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
JWT_SECRET=

# --- AI --------------------------------------------------------------------
# Free key from https://aistudio.google.com/apikey. Powers the voice assistant,
# vision verification, listing descriptions and market insights.
# Every AI surface degrades to a rules-based answer when this is missing or
# rate-limited, so the app still runs without it.
GEMINI_API_KEY=

# Free key from https://console.groq.com/keys. Used for the low-latency paths:
# Whisper transcription of recorded audio in the capture flow, plus the craft
# parser, raw-materials sourcing and live-news summarisation. Without it those
# routes fall back to Gemini (parser) or return an error (audio/news/materials).
GROQ_API_KEY=

# --- Twilio ----------------------------------------------------------------
# Shared by the toll-free IVR (inbound voice) and the SMS demand alerts.
# Inbound webhooks need only the auth token and the number; the auth token is
# what validates X-Twilio-Signature.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# The public HTTPS origin Twilio calls YOUR app on — an ngrok tunnel in dev,
# the deployed origin in production. No trailing slash. Twilio signs the exact
# URL it requested, so a mismatch here fails every signature check.
#   npx ngrok http 3000
# Then set the webhooks in the Twilio Console:
#   Voice     "A call comes in"    -> POST <PUBLIC_BASE_URL>/api/ivr/voice
#   Messaging "A message comes in" -> POST <PUBLIC_BASE_URL>/api/sms/inbound
PUBLIC_BASE_URL=

# Local testing only. Each disables the X-Twilio-Signature check on its
# webhooks, and is honoured ONLY when NODE_ENV !== 'production'. Leave false:
# with the check off, anyone who learns the URL can forge calls and replies.
IVR_SKIP_SIGNATURE=false
SMS_SKIP_SIGNATURE=false

# Optional safety valve for outbound SMS. Comma-separated numbers; when set,
# demand alerts go ONLY to these. The seeded artisan profiles carry
# real-looking Indian mobile numbers, so set this to your own verified number
# while demoing. Empty = text every matched artisan.
#
# Note: a Twilio TRIAL account cannot send custom message bodies at all (only
# predefined templates), so demand alerts require an upgraded account. No code
# change is needed when you upgrade.
SMS_ALLOWLIST=

# --- Razorpay ---------------------------------------------------------------
# Keys from https://dashboard.razorpay.com/app/keys.
#
# TEST vs LIVE. An rzp_test_ key charges nothing; an rzp_live_ key charges a
# REAL ₹1 per purchase (src/lib/razorpay.ts, DEMO_CHARGE_PAISE) and settles it
# into your own Razorpay merchant account. The app reads the prefix and changes
# what it tells the buyer, so the storefront never promises "no live charge"
# while taking one — see src/lib/razorpayMode.ts.
#
# Note that test-mode UPI QR codes are dummies: real UPI apps reject them with
# "invalid QR". Only live keys produce a scannable one.
#
# Either way, no payout rail is wired. Checkout collects into the merchant
# account; it does NOT reach the artisan VPAs on file, so the two escrow
# tranches stay programmatic settlement records rather than bank credits.
# Paying artisans for real would need RazorpayX / Route.
#
# Leave blank and /api/payments/create-order returns an honest 503 instead of
# pretending a payment happened.
#
# RAZORPAY_KEY_SECRET is SERVER-ONLY. It signs and verifies the payment, and it
# must never appear in a client component or behind a NEXT_PUBLIC_ prefix.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_secret_here

# The same key id, deliberately public: Razorpay Checkout needs it in the
# browser to open the modal, and the id alone can only start a payment, never
# verify one. Keep it in step with RAZORPAY_KEY_ID above. The buy button
# actually reads the id off the create-order response rather than this value,
# so a mismatch cannot open a modal against the wrong account — this is here
# so any future client code has the public half declared. Never put the
# secret here.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx

# --- RazorpayX payouts (money OUT to the artisan's UPI) ----------------------
# The keys above only COLLECT. Paying an artisan's VPA is RazorpayX Payouts
# (https://razorpay.com/docs/api/x/payouts/), a separate product needing its own
# activated, KYC'd account with a funded virtual account number. A Checkout key
# — test or live — cannot make a payout.
#
# Left off (the default): /api/payments/settle-escrow still advances the escrow
# ladder and writes the audit trail, but records each tranche as SIMULATED with
# no bank credit behind it. Every audit row says which it was. Turn this on only
# when all three values are real; a half-filled config stays simulated on
# purpose, so a missing secret can never fail a dispatch.
RAZORPAYX_ENABLED=false
RAZORPAYX_KEY_ID=
RAZORPAYX_KEY_SECRET=
RAZORPAYX_ACCOUNT_NUMBER=

# Absolute origin used for the creator referral links. No trailing slash.
# Falls back to PUBLIC_BASE_URL, then to the incoming request origin.
NEXT_PUBLIC_BASE_URL=

# --- ONDC provider node (all optional; sane defaults in src/lib/ondcCatalog.ts)
# KARIGARI serves a Beckn `on_search` catalogue at /api/ondc/catalog. It is a
# spec-shaped payload a registered buyer app could ingest — it does not join the
# live ONDC network and signs nothing. Override these per deployment only.

# Beckn `bpp_id`. Defaults to the host of the request origin.
ONDC_BPP_ID=

# Absolute origin stamped into `bpp_uri` and used to make image URLs absolute.
# Defaults to the incoming request origin. No trailing slash.
ONDC_BPP_URI_ORIGIN=

# ONDC retail domain. Handloom/handicraft has no dedicated code: textile crafts
# transact under RET12 (Fashion), decor under RET16 (Home & Decor).
# Default: ONDC:RET12
ONDC_DOMAIN=

# Beckn context `city`, an STD code (e.g. std:080 for Bengaluru).
# Default: std:080
ONDC_CITY=

# --- YouTube (optional) -----------------------------------------------------
# Data API v3 key from https://console.cloud.google.com/apis/credentials.
# The Learn & Grow assistant uses it to pick a relevance-ranked, embeddable
# tutorial for the artisan's actual craft. Without it the route falls back to
# reading the public search results page, which still works but is scraping.
YOUTUBE_API_KEY=
